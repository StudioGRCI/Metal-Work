# Proyecto Supabase — Configuración > API en el panel de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Solo para scripts de administración y el seed. NUNCA se expone al navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cadena de conexión directa, usada por scripts/db-push.sh y por la CLI de Supabase
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# Credencial que Vercel manda en Authorization: Bearer al llamar /api/tipo-cambio (ver vercel.json).
# Sin ella el cron contesta 401 y el tipo de cambio deja de actualizarse solo, sin avisar.
CRON_SECRET=una-cadena-larga-y-aleatoria
